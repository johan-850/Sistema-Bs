# ============================================================
# Sistema Bs — Variables de entorno
#
# Copia este archivo a .env y reemplaza los valores.
# El archivo .env esta ignorado por git y NUNCA debe subirse.
# ============================================================

# --- Supabase -----------------------------------------------
# Dashboard de Supabase -> Project Settings -> API
# URL del proyecto (termina en .supabase.co)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave publica "anon". Es la unica que puede ir en el cliente.
# La clave service_role NUNCA se pone aqui: solo en los secretos
# de las Edge Functions, del lado del servidor.
SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# --- Aplicacion ---------------------------------------------
# Nombre visible del negocio. Cambialo cuando se defina la marca.
APP_NAME=Sistema Bs

# development | production
APP_ENV=development
